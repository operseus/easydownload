object FrmSettings: TSettingsForm
  Left = 360
  Height = 620
  Top = 180
  Width = 460
  BorderIcons = [biSystemMenu]
  BorderStyle = bsSingle
  Caption = 'Settings'
  ClientHeight = 620
  ClientWidth = 460
  Color = clWindow
  Font.Height = -14
  Font.Name = 'Segoe UI'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Position = poScreenCenter
  LCLVersion = '3.0.0.0'
  object lblLang: TLabel
    Left = 20
    Height = 19
    Top = 18
    Width = 64
    Caption = 'Language'
    Font.Height = -14
    Font.Name = 'Segoe UI'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object cmbLang: TComboBox
    Left = 20
    Height = 27
    Top = 42
    Width = 420
    ItemHeight = 0
    Style = csDropDownList
    OnChange = cmbLangChange
    TabOrder = 0
  end
  object lblTheme: TLabel
    Left = 20
    Height = 19
    Top = 84
    Width = 80
    Caption = 'Theme'
    Font.Height = -14
    Font.Name = 'Segoe UI'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object cmbTheme: TComboBox
    Left = 20
    Height = 27
    Top = 108
    Width = 420
    ItemHeight = 0
    Style = csDropDownList
    OnChange = cmbThemeChange
    TabOrder = 1
  end
  object lblFont: TLabel
    Left = 20
    Height = 19
    Top = 150
    Width = 64
    Caption = 'Font'
    Font.Height = -14
    Font.Name = 'Segoe UI'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object cmbFont: TComboBox
    Left = 20
    Height = 27
    Top = 174
    Width = 420
    ItemHeight = 0
    Style = csDropDownList
    OnChange = cmbFontChange
    TabOrder = 2
  end
  object lblFolder: TLabel
    Left = 20
    Height = 19
    Top = 216
    Width = 180
    Caption = 'Default save folder'
    Font.Height = -14
    Font.Name = 'Segoe UI'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object edtFolder: TEdit
    Left = 20
    Height = 27
    Top = 240
    Width = 360
    Font.Height = -13
    Font.Name = 'Segoe UI'
    ParentFont = False
    ReadOnly = True
    TabOrder = 3
  end
  object lblConcurrent: TLabel
    Left = 20
    Height = 19
    Top = 284
    Width = 240
    Caption = 'Max concurrent downloads'
    Font.Height = -14
    Font.Name = 'Segoe UI'
    ParentFont = False
  end
  object spnConcurrent: TSpinEdit
    Left = 360
    Height = 27
    Top = 280
    Width = 80
    MaxValue = 10
    MinValue = 1
    OnChange = spnConcurrentChange
    TabOrder = 5
    Value = 1
  end
  object chkYtdlpUpdate: TCheckBox
    Left = 20
    Height = 23
    Top = 322
    Width = 300
    Caption = 'Check yt-dlp for updates'
    OnChange = chkYtdlpUpdateChange
    TabOrder = 6
  end
  object chkBackground: TCheckBox
    Left = 20
    Height = 23
    Top = 356
    Width = 420
    Caption = 'Keep running in background'
    OnChange = chkBackgroundChange
    TabOrder = 8
  end
  object chkNotify: TCheckBox
    Left = 20
    Height = 23
    Top = 384
    Width = 420
    Caption = 'Notify when download finishes'
    OnChange = chkNotifyChange
    TabOrder = 9
